#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {
        pointer_sensitivity: z_psens {
            compatible = "zitaotech,behavior-pointing-sensitivity";
            #binding-cells = <1>;
            display-name = "Pointer sensitivity";
        };

        keyboard_light: z_kbl {
            compatible = "zitaotech,behavior-keyboard-backlight";
            #binding-cells = <1>;
            display-name = "Keyboard backlight";
        };

        scroll_step: z_sstep {
            compatible = "zitaotech,behavior-scroll-step";
            #binding-cells = <1>;
            display-name = "Wheel step";
        };

        scroll_encoder: z_sc_enc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&scroll_step>, <&scroll_step>;
            /* Press sends a delta immediately; release is a no-op. */
            tap-ms = <0>;
        };

        backlight_encoder: z_bl_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&keyboard_light 1>, <&keyboard_light 0>;
        };
    };

    input_processors {

        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };

        /omit-if-no-ref/ touch_mouse: touch_mouse {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_TOUCH>;
            bindings = <&mo 3>;
        };

        ip_behaviors0: ip_behaviors0 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_0>;
            bindings = <&kp RIGHT>;
        };
        ip_behaviors1: ip_behaviors1 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_1>;
            bindings = <&kp LEFT>;
        };
        ip_behaviors2: ip_behaviors2 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_2>;
            bindings = <&kp DOWN>;
        };
        ip_behaviors3: ip_behaviors3 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_3>;
            bindings = <&kp UP>;
        };
    };
};

&msc_input_listener {
    device = <&scroll_step>;
};

#ifdef ZITAOTECH_A320_TOUCHPAD
/* Contact owns MOUSE in this variant; motion timeouts must not close it.
 * Other variants and the vendor fallback retain their existing motion policy. */
&bbtrackpad_listener {
    input-processors = <&touch_mouse>;
};

&trackpoint_listener {
    /delete-property/ input-processors;
};
#endif

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp C_MUTE &keyboard_light 2 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BACKSPACE
&kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSLH
&lt 1 LG(SPACE) &kp A &kp S &kp D &kp F &kp G &mkp LCLK &none &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B &mkp MCLK &mkp RCLK &pointer_sensitivity 0 &pointer_sensitivity 1 &kp N &kp M &kp UP_ARROW &kp COMMA &kp PERIOD &kp SLASH
&kp LEFT_ALT &kp LEFT_GUI &kp LCTRL &kp SPACE &kp MINUS &kp EQUAL &kp ENTER &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_encoder MOVE_Y(3) MOVE_Y(-3)>;
        };

        lower_layer {
            display-name = "FUNC";
            bindings = <
&kp ESCAPE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &trans &trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp DELETE
&mo 2 &kp F11 &kp F12 &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &kp LEFT_BRACE &kp LEFT_BRACKET &trans &trans &trans &trans &kp RIGHT_BRACKET &kp RIGHT_BRACE &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp PAGE_UP &trans &trans &kp INSERT
&trans &trans &trans &trans &kp LS(MINUS) &kp LS(EQUAL) &trans &kp HOME &kp PAGE_DOWN &kp END
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_encoder MOVE_X(-3) MOVE_X(3)>;
        };

        raise_layer {
            display-name = "CONF";
            bindings = <
&out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none &trans &trans &none &none &none &none &none &none
&none &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &none &none &none &none &none &none &none
&none &none &none &none &none &none &trans &trans &none &none &none &none &none &none
&bt BT_CLR &none &none &none &none &none &trans &trans &keyboard_light 4 &keyboard_light 3 &none &none &none &none &none &none
&sys_reset &bootloader &soft_off &none &none &none &none &soft_off &bootloader &sys_reset
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &backlight_encoder>;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &mkp LCLK &mkp RCLK &trans &trans &trans
            >;
        };

    };
};
