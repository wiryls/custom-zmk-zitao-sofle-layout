#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define FUNC 1
#define RES 2
#define BOT bootloader

/ {
    input_processors {

        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };

        ip_behaviors0: ip_behaviors0 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_0>;
            bindings = <&kp RIGHT>;
        };
        ip_behaviors1: ip_behaviors1 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_1>;
            bindings = <&kp LEFT>;
        };
        ip_behaviors2: ip_behaviors2 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_2>;
            bindings = <&kp DOWN>;
        };
        ip_behaviors3: ip_behaviors3 {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            codes = <INPUT_BTN_3>;
            bindings = <&kp UP>;
        };
    };
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

        behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
         sp_sc: behavior_spacescroll {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <200>;       /* 长按阈值 */
           bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {
         LMouse_sc: behavior_LMouse_Scroll {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <200>;       /* 长按阈值 */
           bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
         M_kp: behavior_mouse_keypress {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           flavor = "tap-preferred";     /* 单击优先 */
           tapping-term-ms = <200>;       /* 长按阈值 */
           bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };



    behaviors {
        rgb_eff_encoder: rgb_effect_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;
        };
    };

    behaviors {
        rgb_bri_encoder: rgb_brightness_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp C_MUTE &mkp RCLK &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BACKSPACE 
&kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSLH 
&lt 1 LG(SPACE) &kp A &kp S &kp D &kp F &kp G &mkp LCLK &mkp LCLK &kp H &kp J &kp K &kp L &kp SEMI &kp SQT 
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp PG_DN &kp PG_UP &msc SCRL_DOWN &msc SCRL_UP &kp N &kp M &kp UP_ARROW &kp COMMA &kp PERIOD &kp SLASH 
&kp LEFT_ALT &kp LEFT_GUI &kp LCTRL &kp SPACE &kp MINUS &kp EQUAL &kp ENTER &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW 
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            display-name = "FUNC";
            bindings = <
&kp ESCAPE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &bt BT_CLR &kp C_MUTE &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp DELETE 
&mo 2 &kp F11 &kp F12 &trans &trans &trans &trans &trans &trans &trans &trans &trans 
&trans &trans &trans &kp LEFT_BRACE &kp LEFT_BRACKET &trans &mkp RCLK &mkp RCLK &trans &kp RIGHT_BRACKET &kp RIGHT_BRACE &trans &trans &trans 
&trans &trans &trans &trans &trans &trans &trans &trans &bl BL_DEC &bl BL_INC &trans &trans &kp PAGE_UP &trans &trans &kp INSERT 
&trans &trans &trans &trans &kp LS(MINUS) &kp LS(EQUAL) &trans &kp HOME &kp PAGE_DOWN &kp END 
            >;
            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "CONF";
            bindings = <
&out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none &rgb_ug RGB_TOG &ext_power EP_TOG &none &none &none &none &none &none 
&none &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &none &none &none &none &none &none &none 
&none &none &none &none &none &none &mkp RCLK &none &none &none &none &none &none &none 
&bt BT_CLR &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none 
&sys_reset &bootloader &soft_off &none &none &none &none &soft_off &bootloader &sys_reset 
            >;
            sensor-bindings = <&rgb_eff_encoder &rgb_bri_encoder>;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans 
            >;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&none &none &none &none &none &none &none &none &none &none &none &none &none &none 
&none &none &none &none &none &none &none &none &none &none &none &none 
&none &none &none &none &none &none &none &none &none &none &none &none &none &none 
&none &none &none &none &none &none &none &none &none &none &none &none &none &none &none &none 
&none &none &none &none &none &none &none &none &none &none 
            >;
        };
    };
};
